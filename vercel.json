{
  "headers": [
    {
      "source": "/assets/images/og-share.jpg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Content-Type", "value": "image/jpeg" }
      ]
    }
  ],
  "rewrites": [{ "source": "/((?!api/|robots\\.txt|sitemap\\.xml).*)", "destination": "/index.html" }]
}
